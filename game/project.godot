; Engine configuration file.
; Lakbayin — Hanapin. Isulat. Ipanalo.
;
; Comments here start with ';' and NEVER with '#'. Godot's config parser does not
; treat '#' as a comment: it folds the line, and the key underneath it, into one
; garbage quoted key, so the setting below silently never applies. That is what
; had `config/quit_on_go_back=false` reading back as `true`.
;
; Even ';' comments are dropped whenever the editor writes this file back, which
; it does when any setting changes. The durable record of why the non-default
; values below are what they are lives in SPECS.md, "Project settings".

config_version=5

[application]

config/name="Lakbayin"
config/description="Explore the islands, learn Baybayin, and race to deposit Filipino words."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icons/main_192x192.png"
; The back button goes to the screen (Main._notification) instead of killing
; a run in progress; the map swallows it.
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.10, 0.08, 0.13, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/Game.gd"
; Authoritative self-hosted backend.
Net="*res://scripts/net/Backend.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
; Sensor Landscape -- both landscape rotations, portrait locked out.
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Kalam-Regular.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.10, 0.08, 0.13, 1)

[lakbayin]

; HTTPS endpoint published by the named tunnel. Local tests override it with
; LAKBAYIN_SERVER_URL=http://127.0.0.1:8000
server/url="https://server.lakbayin.space"
