; Engine configuration file.
; NumXventure — Explore. Solve. Conquer.
;
; Comments here start with ';' and NEVER with '#'. Godot's config parser does not
; treat '#' as a comment: it folds the line, and the key underneath it, into one
; garbage quoted key, so the setting below silently never applies. That is what
; had `config/quit_on_go_back=false` reading back as `true`.
;
; Even ';' comments are dropped whenever the editor writes this file back, which
; it does when any setting changes. The durable record of why the non-default
; values below are what they are lives in SPECS.md, "Project settings".

config_version=5

[application]

config/name="NumXventure"
config/description="A gamified learning adventure for numerical expressions: integer operations, exponential notation, and order of operations."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
; The back button opens the pause menu (Main._notification) instead of killing
; a run in progress.
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.10, 0.08, 0.13, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/Game.gd"
; The backend, under the name the screens call it by. This is a name, not an
; interface -- there is one implementation. If LAN ever ships, it is this line
; that changes, which is the whole reason the screens never say "Supabase".
Net="*res://scripts/net/Supabase.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; Sensor Landscape -- both landscape rotations, portrait locked out.
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/PixelifySans.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.10, 0.08, 0.13, 1)