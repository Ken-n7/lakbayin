; Engine configuration file.
; NumXventure — Explore. Solve. Conquer.

config_version=5

[application]

config/name="NumXventure"
config/description="A gamified learning adventure for numerical expressions: integer operations, exponential notation, and order of operations."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
# The back button opens the pause menu (Main._notification) instead of killing
# a run in progress.
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.10, 0.08, 0.13, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/Game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/PixelifySans.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.10, 0.08, 0.13, 1)