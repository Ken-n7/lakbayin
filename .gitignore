# Godot 4's local cache: reimported textures, editor folding state, the
# filesystem index. All of it regenerates on open, none of it is shared, and it
# rewrites itself every time the project is run -- which is why it showed up
# dirty after every session. Keep `*.import` and `*.uid` next to the assets
# though; those carry real import settings and stable ids.
game/.godot/

# Exported builds. These live on Drive, not here: an APK is ~28MB and git keeps
# every copy forever, so refreshing it a few times costs more than the entire
# rest of the project. Rebuild with:
#   cd game && godot --headless --export-debug "Android" ../build/NumXventure.apk
build/

# The client's lesson posters (Canva PNGs, ~6MB): source material the Learn
# screen was rebuilt from (LearnScreen.gd), not something the game loads.
learn/

# Bytecode from the one-off scripts in game/tools/
__pycache__/
*.py[cod]

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
build/shots/
build/*.apk
build/*.idsig

# Self-hosted server accounts, sessions, checkpoints and isolated dependencies.
server/data/
server/.venv/

# Original asset pack downloads. The game uses its own copies in game/assets/;
# the licences don't allow passing the packs on as-is.
/Pixel Crawler - Free Pack*
/SuperRetroWorld_CharacterPack_Full*
/Tiny Swords (Free Pack)*

# Deploy keys
server-cred/
*.pem

# Tools kept on this machine only: video, screenshots, the poster and logo,
# asset and word-list generation, the booth's QR sheet. Not needed to run
# the game or the server, or to test them (game/DEVTOOLS.md lists them).
game/tools/Recorder.gd*
game/tools/showcase.*
game/tools/cards.*
game/tools/edit.py
game/tools/backdrop_shot.*
game/tools/button_gallery.*
game/tools/collision_shot.*
game/tools/guide_moments.*
game/tools/guide_shot.*
game/tools/guide_shots.py
game/tools/logo_shot.*
game/tools/ui_shot.*
game/tools/make_icons.py
game/tools/make_words.py
game/tools/fix_glyphs.py
game/tools/tune_fonts.py
game/tools/poster_art.*
game/tools/poster.py
server/booth.py
